{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.csr.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.csr.html",
          "/manifest.webmanifest",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/icons/**",
          "/logo.svg",
          "/**/*.svg",
          "/**/*.png",
          "/**/*.jpg",
          "/**/*.woff2",
          "/**/*.woff"
        ]
      }
    }
  ],
  "navigationUrls": [
    "/**",
    "!/api/**",
    "!/health",
    "!/**/*.*"
  ]
}
