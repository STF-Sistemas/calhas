# Copie este arquivo para .env e preencha os valores
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calhas"
JWT_SECRET="calhas_jwt_secret_troque_em_producao"
JWT_EXPIRES_IN="8h"
PORT=3004

# ── Controle de Licença / Pagamento Pix ──────────────────────────────────────
# Mercado Pago (opcional — se não configurado, usa modo manual com chave estática)
# O valor da mensalidade é configurado por empresa no cadastro (super admin)
# Access Token do Mercado Pago (produção ou sandbox)
MP_ACCESS_TOKEN=
# URL pública do backend para receber notificações de pagamento (webhook)
BACKEND_URL=https://seu-backend.com

# Modo manual: chave Pix estática para pagamento (Nubank, banco, etc.)
# Pode ser CPF, CNPJ, e-mail, telefone ou chave aleatória
PIX_CHAVE_MANUAL=

# ── E-mail / Recuperação de Senha ─────────────────────────────────────────────
# URL pública do frontend (usada no link de redefinição de senha)
FRONTEND_URL=http://localhost:4204
# Configurações SMTP (Gmail, SendGrid, Mailgun, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# ── Push Notification (Web Push / VAPID) ──────────────────────────────────────
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@calhaspro.com.br
