# Copie este arquivo para .env e preencha os valores.
# Na Discloud, cadastre as mesmas variáveis no painel e reinicie o app.

NODE_ENV=development
# Produção (Discloud): PORT=8080
PORT=3004
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/calhas"
# Mínimo de 32 caracteres. Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN="8h"

# Endereço público do site, com https:// e sem barra no fim (obrigatório em produção).
# Usado nas meta tags (canonical, og:url, og:image), nos links enviados por WhatsApp e e-mail,
# no CORS e no webhook do Mercado Pago (quando BACKEND_URL estiver vazio).
FRONTEND_URL=http://localhost:4204
# Origens extras liberadas no CORS, separadas por vírgula (opcional)
ALLOWED_ORIGINS=

# Super administrador criado pelo seed no primeiro início (opcional).
# Sem senha, o seed gera uma provisória e mostra no log uma única vez.
SUPER_ADMIN_EMAIL=super@calhas.com
SUPER_ADMIN_SENHA=

# ── Licença / Pagamento Pix ───────────────────────────────────────────────────
# Mercado Pago (opcional; sem token usa o modo manual com chave estática)
MP_ACCESS_TOKEN=
# URL pública para o webhook do Mercado Pago (padrão: FRONTEND_URL)
BACKEND_URL=
# Modo manual: chave Pix estática (CPF, CNPJ, e-mail, telefone ou aleatória)
PIX_CHAVE_MANUAL=

# ── E-mail / Recuperação de senha ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app

# ── Push (Web Push / VAPID) ───────────────────────────────────────────────────
# Gere o par de chaves com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contato@calhaspro.com.br
